<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danjazral AI - All-in-One Assistant</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f8f8f8;
        }
        .container {
            max-width: 700px;
            margin: auto;
            padding: 20px;
            background: white;
            border-radius: 10px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
        }
        h1 {
            color: #d63384; /* Pink Theme */
        }
        .ai-tool {
            display: block;
            margin: 10px 0;
            padding: 10px;
            background-color: #6f42c1; /* Purple Theme */
            color: white;
            text-decoration: none;
            border-radius: 5px;
        }
        .ai-tool:hover {
            background-color: #5a379a;
        }
        input, button {
            padding: 10px;
            margin: 10px 0;
            width: 80%;
        }
        #aiResponse, #searchResults {
            margin-top: 20px;
            text-align: left;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Danjazral AI - All-in-One</h1>
    <p>Interact with AI, search the web, and explore AI tools.</p>

    <!-- AI Chat Assistant -->
    <h3>🤖 Chat with Danjazral AI</h3>
    <input type="text" id="userInput" placeholder="Ask AI anything...">
    <button onclick="askAI()">Chat</button>
    <div id="aiResponse"></div>

    <!-- AI Search -->
    <h3>🔍 Search the Web with AI</h3>
    <input type="text" id="searchQuery" placeholder="Enter search term...">
    <button onclick="searchWeb()">Search</button>
    <div id="searchResults"></div>

    <!-- AI Tools -->
    <h3>🎨 More AI Tools</h3>
    <a href="https://danjazral.com/image-generator" class="ai-tool">🎨 AI Image Generator</a>
    <a href="https://danjazral.com/video-tools" class="ai-tool">🎬 AI Video Tools</a>
    <a href="https://danjazral.com/document-analysis" class="ai-tool">📄 AI Document Analysis</a>
    <a href="https://danjazral.com/voice-assistant" class="ai-tool">🎙️ AI Voice Assistant</a>
</div>

<script>
    async function askAI() {
        const userInput = document.getElementById("userInput").value;
        document.getElementById("aiResponse").innerHTML = "Thinking...";
        
        const response = await fetch("https://danjazral-ai.onrender.com/api/ask", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ prompt: userInput })
        });

        const data = await response.json();
        document.getElementById("aiResponse").innerHTML = "<strong>AI:</strong> " + data.reply;
    }

    async function searchWeb() {
        const query = document.getElementById("searchQuery").value;
        const apiKey = "YOUR_GOOGLE_API_KEY";  // Replace with your Google API Key
        const searchEngineId = "YOUR_SEARCH_ENGINE_ID";  // Replace with your Search Engine ID
        
        const url = `https://www.googleapis.com/customsearch/v1?q=${query}&key=${apiKey}&cx=${searchEngineId}`;
        
        const response = await fetch(url);
        const data = await response.json();

        let resultsHTML = "<h4>Search Results:</h4>";
        data.items.forEach(item => {
            resultsHTML += `<p><a href="${item.link}" target="_blank">${item.title}</a></p>`;
        });

        document.getElementById("searchResults").innerHTML = resultsHTML;
    }
</script>

</body>
</html>
